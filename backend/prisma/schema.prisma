generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username          String         @unique @db.VarChar(32)
  email             String         @unique @db.VarChar(255)
  passwordHash      String         @map("password_hash")
  displayName       String?        @map("display_name") @db.VarChar(64)
  avatarUrl         String?        @map("avatar_url") // object storage key
  status            UserStatus     @default(online)
  // Settings: 1:1 with the user and read with every /users/me, so they live on the row.
  theme                  Theme             @default(system)
  notificationsMuted     Boolean           @default(false) @map("notifications_muted")
  /// Tags left out of the bell. Presentation only: the notifications are still stored.
  hiddenNotificationTags NotificationTag[] @default([]) @map("hidden_notification_tags")
  /// MediaDeviceInfo.deviceId, which is per browser and origin: may not exist on another machine.
  audioInputId           String?           @map("audio_input_id") @db.VarChar(256)
  audioOutputId          String?           @map("audio_output_id") @db.VarChar(256)
  /// Users whose notifications are dropped before they are stored (right-click > Silenciar).
  mutedUserIds           String[]          @default([]) @map("muted_user_ids") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  sessions          Session[]
  keys              UserKey[]
  ownedServers      Server[]
  memberships       ServerMember[]
  createdInvites    Invite[]
  friendshipsLow    Friendship[]   @relation("friendshipLow")
  friendshipsHigh   Friendship[]   @relation("friendshipHigh")
  friendRequests    Friendship[]   @relation("friendshipRequester")
  friendBlocks      Friendship[]   @relation("friendshipBlocker")
  notifications     Notification[] @relation("notificationReceiver")
  notificationsSent Notification[] @relation("notificationOwner")
  channelKeyShares  ChannelKeyShare[]
  mediaFiles        MediaFile[]
  serverBans        ServerBan[]

  @@map("users")
}

enum Theme {
  system
  dark
  light

  @@map("theme")
}

/// What the user shows to others. Chosen by the user, not derived from the socket (yet).
enum UserStatus {
  online
  offline
  dnd

  @@map("user_status")
}

/// Public half of the user's E2E keypair (ECDH P-256, SPKI base64). The private key never
/// leaves the browser (non-extractable CryptoKey in IndexedDB), so the server cannot decrypt.
/// Rotating publishes a new row and deactivates the previous one; old rows stay so old
/// messages can still name the key they were encrypted for.
model UserKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  publicKey String   @map("public_key")
  algorithm String   @default("ECDH-P256") @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_keys")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") // sha256
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Server {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String           @map("owner_id") @db.Uuid
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(300)
  category    String           @default("other") @db.VarChar(32) // one of SERVER_CATEGORIES (lib/constants.ts)
  iconUrl     String?          @map("icon_url") // object storage key
  bannerUrl   String?          @map("banner_url") // object storage key, card background on /descobrir
  visibility  ServerVisibility @default(public)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  owner       User             @relation(fields: [ownerId], references: [id])
  members     ServerMember[]
  roles       Role[]
  invites     Invite[]
  channels    Channel[]
  bans        ServerBan[]

  @@index([ownerId])
  @@map("servers")
}

/// A banned user cannot join again, by invite or through discovery.
model ServerBan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId  String   @map("server_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bannedBy  String   @map("banned_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@map("server_bans")
}

enum ServerVisibility {
  public
  private

  @@map("server_visibility")
}

model ServerMember {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId String       @map("server_id") @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  nickname String?      @db.VarChar(64)
  joinedAt DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  server   Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles    MemberRole[]
  channelPermissions ChannelMemberPermission[]

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@map("server_members")
}

/// permissions is a bitfield; see PERMISSIONS in lib/constants.ts. isDefault marks @everyone.
model Role {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId    String       @map("server_id") @db.Uuid
  name        String       @db.VarChar(64)
  color       Int?
  permissions BigInt       @default(0)
  position    Int          @default(0) // hierarchy
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  server      Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members     MemberRole[]
  channelPermissions ChannelRolePermission[]

  @@index([serverId])
  @@map("roles")
}

model MemberRole {
  memberId String       @map("member_id") @db.Uuid
  roleId   String       @map("role_id") @db.Uuid
  member   ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model Invite {
  code      String    @id @db.VarChar(16)
  serverId  String    @map("server_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])

  @@index([serverId])
  @@map("invites")
}

enum ChannelType {
  text
  voice

  @@map("channel_type")
}

/// A server has many text channels and at most one voice channel; the single-voice rule is a
/// partial unique index added by hand in the migration (Prisma cannot express a WHERE clause).
model Channel {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId  String      @map("server_id") @db.Uuid
  type      ChannelType
  name      String      @db.VarChar(100)
  topic     String?
  position  Int         @default(0)
  /// Voice only: people allowed in the call at once (1-12).
  userLimit Int         @default(12) @map("user_limit")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  rolePermissions   ChannelRolePermission[]
  memberPermissions ChannelMemberPermission[]
  keyEpochs         ChannelKeyEpoch[]

  @@index([serverId])
  @@map("channels")
}

/// Channel overwrite for a role (@everyone included): deny bits are cleared, then allow bits set.
/// A private channel is just @everyone denied VIEW_CHANNELS.
model ChannelRolePermission {
  channelId String  @map("channel_id") @db.Uuid
  roleId    String  @map("role_id") @db.Uuid
  allow     BigInt  @default(0)
  deny      BigInt  @default(0)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([channelId, roleId])
  @@index([roleId])
  @@map("channel_role_permissions")
}

/// Channel overwrite for one member; applied after every role overwrite, so it wins.
model ChannelMemberPermission {
  channelId String       @map("channel_id") @db.Uuid
  memberId  String       @map("member_id") @db.Uuid
  allow     BigInt       @default(0)
  deny      BigInt       @default(0)
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member    ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([channelId, memberId])
  @@index([memberId])
  @@map("channel_member_permissions")
}

/// One symmetric key per channel epoch (arquitetura-lucaco.md 7.2). The key itself only exists
/// in the browsers; the server stores it wrapped for each member (channel_key_shares).
model ChannelKeyEpoch {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId String            @map("channel_id") @db.Uuid
  epoch     Int
  createdBy String            @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  shares    ChannelKeyShare[]

  @@unique([channelId, epoch])
  @@map("channel_key_epochs")
}

/// The epoch key encrypted for one recipient with ECDH(wrapper private, recipient public).
/// wrapperPublicKey is the SPKI the wrapper used, so a later key rotation does not orphan it.
model ChannelKeyShare {
  epochId          String          @map("epoch_id") @db.Uuid
  recipientId      String          @map("recipient_id") @db.Uuid
  wrappedBy        String          @map("wrapped_by") @db.Uuid
  wrapperPublicKey String          @map("wrapper_public_key")
  encryptedKey     String          @map("encrypted_key")
  iv               String
  epoch            ChannelKeyEpoch @relation(fields: [epochId], references: [id], onDelete: Cascade)
  recipient        User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([epochId, recipientId])
  @@index([recipientId])
  @@map("channel_key_shares")
}

enum MessageScope {
  dm
  channel

  @@map("message_scope")
}

enum MediaKind {
  voice
  image
  file
  video

  @@map("media_kind")
}

/// Attachment. voice/file/video are ciphertext (encrypted in the browser); image is the webp the
/// server made, in the clear. The bytes are ciphertext; the key travels inside
/// the E2E message. conversationId is the channel id or the derived DM id, hence no FK.
model MediaFile {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaderId     String       @map("uploader_id") @db.Uuid
  scope          MessageScope
  conversationId String       @map("conversation_id") @db.Uuid
  storageKey     String       @map("storage_key")
  kind           MediaKind    @default(voice)
  sizeBytes      Int          @map("size_bytes")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("media_files")
}

enum FriendshipStatus {
  pending
  accepted
  blocked

  @@map("friendship_status")
}

/// One row per relationship in canonical order (userLowId < userHighId), which makes the pair unique.
/// requestedBy keeps the direction of the invite; blockedBy is set only when status is blocked.
model Friendship {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId   String           @map("user_low_id") @db.Uuid
  userHighId  String           @map("user_high_id") @db.Uuid
  status      FriendshipStatus @default(pending)
  requestedBy String           @map("requested_by") @db.Uuid
  blockedBy   String?          @map("blocked_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz
  userLow     User             @relation("friendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User             @relation("friendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  requester   User             @relation("friendshipRequester", fields: [requestedBy], references: [id])
  blocker     User?            @relation("friendshipBlocker", fields: [blockedBy], references: [id])

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@map("friendships")
}

enum NotificationTag {
  friend_request
  friend_accepted
  new_message
  mention

  @@map("notification_tag")
}

/// What lands in a user's inbox, pushed live to the `user:<id>` socket room. For a friend
/// request the friendships row stays the source of truth; the notification is only the
/// message and is deleted once the request is answered, cancelled or blocked.
model Notification {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag        NotificationTag
  title      String          @db.VarChar(120)
  subtitle   String?         @db.VarChar(120)
  /// Who caused it (the user who sent the request, accepted it, ...).
  ownerId    String          @map("owner_id") @db.Uuid
  receiverId String          @map("receiver_id") @db.Uuid
  /// Set on mentions only: the channel to open.
  serverId   String?         @map("server_id") @db.Uuid
  channelId  String?         @map("channel_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  owner      User            @relation("notificationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  receiver   User            @relation("notificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt])
  @@map("notifications")
}
