generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String         @unique @db.VarChar(32)
  email           String         @unique @db.VarChar(255)
  passwordHash    String         @map("password_hash")
  displayName     String?        @map("display_name") @db.VarChar(64)
  avatarUrl       String?        @map("avatar_url") // object storage key
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  sessions        Session[]
  keys            UserKey[]
  ownedServers    Server[]
  memberships     ServerMember[]
  createdInvites  Invite[]
  friendshipsLow  Friendship[]   @relation("friendshipLow")
  friendshipsHigh Friendship[]   @relation("friendshipHigh")
  friendRequests  Friendship[]   @relation("friendshipRequester")
  friendBlocks    Friendship[]   @relation("friendshipBlocker")

  @@map("users")
}

/// Public half of the user's E2E keypair (ECDH P-256, SPKI base64). The private key never
/// leaves the browser (non-extractable CryptoKey in IndexedDB), so the server cannot decrypt.
/// Rotating publishes a new row and deactivates the previous one; old rows stay so old
/// messages can still name the key they were encrypted for.
model UserKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  publicKey String   @map("public_key")
  algorithm String   @default("ECDH-P256") @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_keys")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") // sha256
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Server {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String           @map("owner_id") @db.Uuid
  name       String           @db.VarChar(100)
  iconUrl    String?          @map("icon_url") // object storage key
  visibility ServerVisibility @default(public)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  owner      User             @relation(fields: [ownerId], references: [id])
  members    ServerMember[]
  roles      Role[]
  invites    Invite[]
  channels   Channel[]

  @@index([ownerId])
  @@map("servers")
}

enum ServerVisibility {
  public
  private

  @@map("server_visibility")
}

model ServerMember {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId String       @map("server_id") @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  nickname String?      @db.VarChar(64)
  joinedAt DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  server   Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles    MemberRole[]

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@map("server_members")
}

/// permissions is a bitfield; see PERMISSIONS in lib/constants.ts. isDefault marks @everyone.
model Role {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId    String       @map("server_id") @db.Uuid
  name        String       @db.VarChar(64)
  color       Int?
  permissions BigInt       @default(0)
  position    Int          @default(0) // hierarchy
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  server      Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members     MemberRole[]

  @@index([serverId])
  @@map("roles")
}

model MemberRole {
  memberId String       @map("member_id") @db.Uuid
  roleId   String       @map("role_id") @db.Uuid
  member   ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model Invite {
  code      String    @id @db.VarChar(16)
  serverId  String    @map("server_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])

  @@index([serverId])
  @@map("invites")
}

enum ChannelType {
  text
  voice

  @@map("channel_type")
}

/// A server has many text channels and at most one voice channel; the single-voice rule is a
/// partial unique index added by hand in the migration (Prisma cannot express a WHERE clause).
model Channel {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId  String      @map("server_id") @db.Uuid
  type      ChannelType
  name      String      @db.VarChar(100)
  topic     String?
  position  Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("channels")
}

enum FriendshipStatus {
  pending
  accepted
  blocked

  @@map("friendship_status")
}

/// One row per relationship in canonical order (userLowId < userHighId), which makes the pair unique.
/// requestedBy keeps the direction of the invite; blockedBy is set only when status is blocked.
model Friendship {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId   String           @map("user_low_id") @db.Uuid
  userHighId  String           @map("user_high_id") @db.Uuid
  status      FriendshipStatus @default(pending)
  requestedBy String           @map("requested_by") @db.Uuid
  blockedBy   String?          @map("blocked_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz
  userLow     User             @relation("friendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User             @relation("friendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  requester   User             @relation("friendshipRequester", fields: [requestedBy], references: [id])
  blocker     User?            @relation("friendshipBlocker", fields: [blockedBy], references: [id])

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@map("friendships")
}
